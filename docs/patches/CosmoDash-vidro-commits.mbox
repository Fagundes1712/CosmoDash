+/* rótulos e barras */
+.chip{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 8px;border-radius:6px;font-size:.7058823529rem;line-height:1.3333733333;font-weight:500;letter-spacing:-.01em;background:var(--fill-q);color:var(--label);white-space:nowrap}
