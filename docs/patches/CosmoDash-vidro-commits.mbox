+:root{
+  color-scheme:light dark;
+  --font-text:"SF Pro Text",system-ui,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Helvetica","Arial",sans-serif;
+  --font-display:"SF Pro Display",system-ui,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Helvetica","Arial",sans-serif;
+  /* --color-figure-gray, -secondary, -secondary-alt, -tertiary */
+  --label:#1d1d1f;--label-2:#6e6e73;--label-2-alt:#515154;--label-3:#86868b;
+  /* --color-fill-tertiary (página), --color-fill (cartão), --color-fill-secondary (navegador lateral) */
+  --page:#f5f5f7;--card:#fff;--sidebar:#fbfbfd;
+  /* --color-grid / --color-fill-gray-tertiary, --color-fill-gray-quaternary, --color-fill-gray-secondary */
+  --separator:#d2d2d7;--fill-q:#e8e8ed;--field-border:#86868b;
+  /* --color-fill-blue, --color-figure-blue, botão hover/active */
+  --accent:#0071e3;--accent-text:#06c;--accent-hover:#0077ed;--accent-active:#06c;--on-accent:#fff;
+  --focus:rgba(0,125,250,.6);--nav-hover:rgba(0,113,227,.05);--keyline:rgba(29,29,31,.2);
+  /* --color-figure-orange, --color-syntax-keywords, --color-type-icon-teal */
+  --orange:#bf4800;--pink:#ad3da4;--teal:#509ca3;
+}
+@media (prefers-color-scheme:dark){
+  :root:not([data-color-scheme=light]){
+    --label:#f5f5f7;--label-2:#86868b;--label-2-alt:#a1a1a6;--label-3:#6e6e73;
+    --page:#000;--card:#1d1d1f;--sidebar:#161617;
+    --separator:#424245;--fill-q:#333336;--field-border:#6e6e73;
+    --accent:#0071e3;--accent-text:#2997ff;--accent-hover:#0077ed;--accent-active:#0071e3;
+    --nav-hover:rgba(0,113,227,.5);--keyline:rgba(66,66,69,.95);
+    --orange:#f56300;--pink:#ff7ab2;
+  }
+}
+:root[data-color-scheme=dark]{
+  --label:#f5f5f7;--label-2:#86868b;--label-2-alt:#a1a1a6;--label-3:#6e6e73;
