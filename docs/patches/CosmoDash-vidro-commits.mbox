-.me-sub{display:block;font-size:11.5px;font-weight:500}
-.scheme{display:none}
+@media (max-width:760px){
+  .side,.collapsed .side{flex-basis:100%;width:100%;flex-direction:row;align-items:center;overflow-x:auto;border-right:0;border-bottom:1px solid var(--separator);padding:8px 12px}
+  .side .hide-m,.navh,.side-head .hide-c,.org-txt{display:none!important}
+  .side-head{padding:0}
+  .side nav{flex-direction:row!important}
+  .nav .lbl{display:none}
+  .org{min-height:44px;width:auto;padding:4px 6px}
+  .orgmenu{position:fixed;left:12px;right:12px;top:68px}
+  .side-foot{margin:0 0 0 auto!important;flex-direction:row!important}
+  .side-foot .nav{min-height:44px!important;padding:0 4px}
+  .main{padding:16px 16px 40px}
+  .h1{font-size:1.4117647059rem;line-height:1.1666666667;letter-spacing:.009em}
+}
+
+/* formulários: .filter do DocC (borda --color-fill-gray-secondary, raio 12px) */
+.lb{display:block;margin-bottom:6px;font-size:.7058823529rem;line-height:1.3333733333;font-weight:600;letter-spacing:-.01em;color:var(--label-2)}
+.inp{width:100%;height:40px;padding:0 .5882352941rem;border:1px solid var(--field-border);border-radius:12px;background:var(--card);color:var(--label);font:inherit;font-size:.8235294118rem;letter-spacing:-.016em}
+textarea.inp{height:auto;padding:10px .5882352941rem;resize:vertical;line-height:1.4705882353}
+select.inp{appearance:none;cursor:pointer}
+.inp::placeholder{color:var(--label-2)}
+.inp:focus{outline:4px solid var(--focus);outline-offset:1px}
+.err{padding:10px 12px;border-radius:12px;border:1px solid var(--orange);color:var(--orange);font-size:.8235294118rem;line-height:1.2857742857}
+.chk{width:20px;height:20px;flex:0 0 20px;padding:0;display:grid;place-items:center;border-radius:5px;border:1.5px solid var(--field-border);background:var(--card);color:transparent;cursor:pointer}
+.chk.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
+.chk[disabled]{opacity:.45;cursor:not-allowed}
+.tog{position:relative;width:40px;height:24px;flex:0 0 40px;padding:0;border:0;border-radius:9999px;background:var(--separator);cursor:pointer}
+.tog:after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .15s ease-out}
+.tog.on{background:var(--accent)}
+.tog.on:after{left:18px}
+
+/* tabelas */
+.tblw{overflow-x:auto}
+.tbl{width:100%;min-width:720px;border-collapse:collapse;font-size:.8235294118rem;line-height:1.2857742857;letter-spacing:-.016em}
+.tbl th{padding:10px 14px;text-align:left;font-size:.7058823529rem;line-height:1.3333733333;font-weight:600;letter-spacing:-.01em;color:var(--label-2);border-bottom:1px solid var(--separator)}
+.tbl td{padding:12px 14px;border-bottom:1px solid var(--separator);vertical-align:middle}
+.tbl tr:last-child td{border-bottom:0}
+.tbl tr.rw{cursor:pointer}
+.tbl tr.rw:hover td{background:var(--nav-hover)}
+.tbl tr.sel td{background:var(--fill-q)}
+.compact .tbl td{padding:7px 14px}
+
+/* modal */
+.ov{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.4)}
+.modal{width:min(560px,100%);max-height:calc(100vh - 32px);overflow:auto;padding:24px;border-radius:18px;background:var(--card);border:1px solid var(--keyline);color:var(--label)}
+
+/* funil */
+.dealcard{cursor:grab}
+.dropzone{outline:2px dashed var(--accent);outline-offset:-2px}
+.side-nav{display:flex;flex-direction:column;gap:2px}
+.av.lg{width:56px;height:56px;flex-basis:56px;font-size:18px}
+.live{width:7px;height:7px;border-radius:50%;background:var(--teal)}
+.mut,.dim{color:var(--label-2)}
+
+/* avatares e marcas de organização: monograma neutro, como em Contatos */
+.av{background-color:var(--fill-q)!important}
+.av.me{background-color:var(--accent)!important}
+.orgmark{color:#fff}
