{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.js\"",
            "timeout": 15,
            "statusMessage": "Conferindo regras do repositório"
          }
        ]
      }
    ]
  }
}
