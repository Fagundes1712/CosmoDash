+  --separator:#424245;--fill-q:#333336;--field-border:#6e6e73;
+  --accent:#0071e3;--accent-text:#2997ff;--accent-hover:#0077ed;--accent-active:#0071e3;
+  --nav-hover:rgba(0,113,227,.5);--keyline:rgba(66,66,69,.95);
+  --orange:#f56300;--pink:#ff7ab2;
+}
+
+/* base: html 17px, corpo 1rem/1.4705882353, -0.022em (DocC) */
+*{box-sizing:border-box}
+html{font:17px var(--font-text);background:var(--page)}
+html,body{margin:0}
+body{font-size:1rem;line-height:1.4705882353;font-weight:400;letter-spacing:-.022em;color:var(--label);background:var(--page);-webkit-font-smoothing:antialiased;font-feature-settings:"tnum" 1}
+a{color:var(--accent-text);text-decoration:none}
+a:hover{text-decoration:underline}
+button{font-family:inherit;letter-spacing:inherit}
+:focus{outline:none}
+:focus-visible{outline:4px solid var(--focus);outline-offset:1px}
+
+/* tipografia (escala DocC, base 17px) */
+.h1{font:600 1.8823529412rem/1.125 var(--font-display);letter-spacing:.004em;margin:0}
+.h2{font:600 1rem/1.2353641176 var(--font-text);letter-spacing:-.022em;margin:0}
+.hud,.t2{color:var(--label-2)}
+.hud{font-size:.8235294118rem;line-height:1.2857742857;letter-spacing:-.016em}
+.small{font-size:.8235294118rem;line-height:1.2857742857;letter-spacing:-.016em}
+.caption{font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em}
+.t3{color:var(--label-2)}
+.ac{color:var(--accent-text)}
+.warn{color:var(--orange)}
+.pk{color:var(--pink)}
+.disp{font-family:var(--font-display)}
+.kpi{font:600 1.8823529412rem/1.125 var(--font-display);letter-spacing:.004em}
+.xp{font-size:.8235294118rem;line-height:1.2857742857;font-weight:600;letter-spacing:-.016em;color:var(--pink)}
+
+/* estrutura */
+.app{min-height:100vh;display:flex;flex-wrap:wrap;background:var(--page)}
+.main{flex:999 1 560px;min-width:0;padding:22px 22px 44px;display:flex;flex-direction:column;gap:20px}
+.top{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
+.grid-a{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))}
+.split{display:grid;gap:20px;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr)}
+.tri{display:grid;gap:20px;grid-template-columns:repeat(3,minmax(0,1fr))}
+
+/* menu lateral: navigator do DocC */
+.side{flex:0 0 252px;width:252px;padding:16px 12px;display:flex;flex-direction:column;gap:4px;background:var(--sidebar);border-right:1px solid var(--separator);transition:flex-basis .15s ease,width .15s ease}
+.collapsed .side{flex-basis:76px;width:76px}
+.collapsed .hide-c{display:none!important}
+.side-head{display:flex;align-items:center;gap:10px;padding:0 6px 12px}
+.collapsed .side-head{flex-direction:column;padding-bottom:8px}
+.logo{width:32px;height:32px;flex:0 0 32px;border-radius:8px;display:grid;place-items:center;background:var(--accent);color:var(--on-accent)}
+.brand{font:600 1rem/1.2353641176 var(--font-text);letter-spacing:-.022em;color:var(--label)}
+.brand-sub{font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em;color:var(--label-2)}
+.orgwrap{position:relative;margin-bottom:4px}
+.org{display:flex;align-items:center;gap:10px;width:100%;min-height:44px;padding:6px 8px;border-radius:12px;border:1px solid var(--separator);background:var(--card);color:var(--label);text-align:left;cursor:pointer;font:inherit}
+.org:hover{background:var(--nav-hover)}
+.collapsed .org{justify-content:center;padding:6px 0}
+.orgmark{width:28px;height:28px;flex:0 0 28px;border-radius:6px;display:grid;place-items:center;font:600 .7058823529rem var(--font-text);color:#1d1d1f}
+.org-name,.om-name{display:block;font-size:.8235294118rem;line-height:1.2857742857;font-weight:600;letter-spacing:-.016em}
+.org-sub,.om-sub{display:block;font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em;color:var(--label-2)}
+.orgmenu{position:absolute;left:0;right:0;top:50px;z-index:30;min-width:230px;padding:6px;display:flex;flex-direction:column;gap:2px;background:var(--card);border:1px solid var(--keyline);border-radius:12px}
+.orgmenu .hud{font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em}
+.navh{font-size:.7058823529rem;line-height:1.3333733333;font-weight:600;letter-spacing:-.01em;color:var(--label-2);padding:14px 10px 4px}
+.collapsed .navh{display:none}
+.nav{position:relative;display:flex;align-items:center;gap:10px;min-height:32px;padding:5px 10px;border-radius:6px;color:var(--label-2);text-decoration:none;font-size:.8235294118rem;line-height:1.2857742857;letter-spacing:-.016em;transition:color .15s ease-in,background .15s ease-in}
+.nav:hover{color:var(--label);background:var(--nav-hover);text-decoration:none}
+.nav.on{color:var(--label);font-weight:600;background:var(--fill-q)}
+.nav.on .ico{color:var(--accent-text)}
+.collapsed .nav{justify-content:center;padding:5px 0}
+.chip.nav-badge{height:auto;padding:0;background:none;box-shadow:none;font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em;color:var(--label-2);font-weight:400}
+.side-foot{margin-top:auto;display:flex;flex-direction:column;gap:8px}
+.xpcard{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:12px;background:var(--card);border:1px solid var(--separator);color:var(--label);text-decoration:none}
+.xpcard:hover{text-decoration:none;background:var(--nav-hover)}
+.xp-tier{font-size:.7058823529rem;line-height:1.3333733333;font-weight:600;letter-spacing:-.01em;color:var(--pink)}
+.xpcard .xp{font-size:.7058823529rem}
+.xpcard > div:first-child{flex-wrap:wrap}
+.xpcard .xp-tier{white-space:nowrap}
+.xp-left{font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em;color:var(--label-2)}
+.me-name{display:block;color:var(--label);font-size:.8235294118rem;line-height:1.2857742857}
+.me-sub{display:block;font-size:.7058823529rem;line-height:1.3333733333;font-weight:400;color:var(--label-2)}
