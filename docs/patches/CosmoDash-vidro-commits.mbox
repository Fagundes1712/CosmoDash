+
+/* seletor de aparência: .color-scheme-toggle do DocC (raio externo 15px; interno 13px, concêntrico) */
+.scheme{display:inline-flex;align-self:flex-start;padding:1px;border:1px solid var(--accent);border-radius:15px;font-size:.7058823529rem;line-height:1.3333733333;letter-spacing:-.01em}
+.scheme button,.seg button{min-width:42px;padding:1px 8px;border:1px solid transparent;border-radius:13px;background:none;color:var(--accent-text);cursor:pointer;font:inherit}
