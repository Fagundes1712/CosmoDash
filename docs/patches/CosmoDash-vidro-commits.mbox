+.seg button{min-height:24px}
+
+/* ícones */
+.ico{width:18px;height:18px;flex:0 0 18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
+.ico.s{width:16px;height:16px;flex-basis:16px}
+.icob{width:32px;height:32px;flex:0 0 32px;display:grid;place-items:center;border-radius:6px;border:0;background:none;color:var(--label-2);cursor:pointer}
