{
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh repo edit *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh repo edit *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.js\"",
            "timeout": 240,
            "statusMessage": "Conferindo regras do repositório"
          }
        ]
      }
    ]
  }
}
