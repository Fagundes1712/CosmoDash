+
+/* campo do Cosmo: .filter do DocC (borda 1px, raio 12px, padding .7647rem/.5882rem) */
+.cmd{flex:1 1 320px;display:flex;align-items:center;gap:10px;min-height:44px;padding:0 .5882352941rem;border:1px solid var(--field-border);border-radius:12px;background:var(--card);cursor:text}
+.cmd:focus-within{outline:4px solid var(--focus);outline-offset:1px}
