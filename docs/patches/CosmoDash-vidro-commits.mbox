+/* classes do menu lateral compartilhado; mantêm o visual das telas que ainda não foram migradas para apple.css */
+.logo{color:#04141A}
+.brand{font-family:'Chakra Petch','Manrope',sans-serif;font-size:15px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
+.brand-sub{font:600 9.5px 'JetBrains Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
+.org-name{display:block;font-weight:700;font-size:13.5px}
+.org-sub{display:block;font-size:11.5px;color:#9AADC1}
+.om-name{display:block;font-weight:700;font-size:13px}
+.om-sub{display:block;font-size:11px;color:#9AADC1}
+.chip.nav-badge{height:20px;padding:0 8px;font-size:11px}
+.xpcard{padding:14px;border-radius:16px;text-decoration:none;color:#E7EEF6;display:flex;flex-direction:column;gap:8px}
+.xp-tier{color:#ADA0FF}
+.xp-left{font-size:11.5px;color:#9AADC1}
+.av.me{background:#5FE0F0}
+.me-name{display:block;color:#E7EEF6;font-size:13.5px}
+.me-sub{display:block;font-size:11.5px;font-weight:500}
+.scheme{display:none}
